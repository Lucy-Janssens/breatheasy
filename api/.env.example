# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Database
DATABASE_URL=sqlite:///./data/breatheasy.db

# GPIO Pins
MOTION_SENSOR_PIN=4
DHT_SENSOR_PIN=17

# I2C Addresses
BME680_ADDRESS=118  # 0x76
OLED_ADDRESS=60     # 0x3C

# Intervals (seconds)
SENSOR_POLL_INTERVAL=30
DISPLAY_TIMEOUT=60

# MQTT
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883

# Tailscale (optional)
# TAILSCALE_HOSTNAME=your-pi-hostname
